clc;
clear;

% Input values
r = input('Enter the value of r = ');
phi = input('Enter the value of phi (degrees) = ');
theta = input('Enter the value of theta (degrees) = ');

% Spherical to Cartesian
x = r * sind(theta) * cosd(phi);
y = r * sind(theta) * sind(phi);
z = r * cosd(theta);

disp('Spherical to Cartesian Coordinate System P(x, y, z) = ');
disp([x y z]);

% Spherical to Cylindrical
rho = r * sind(theta);

disp('Spherical to Cylindrical Coordinate System S(rho, phi, z) = ');
disp([rho phi z]);
