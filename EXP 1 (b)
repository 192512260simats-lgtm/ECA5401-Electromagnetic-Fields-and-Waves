clc;
r=input('Enter the value of r=');
phi=input('Enter the value of phi=');
z=input('Enter the value of z=');
% Cylindrical to Cartesian
x=r*cosd(phi);
y=r*sind(phi);
disp('cylindrical to cartesian coordinate system of p(x,y,z)=');
disp([x y z]);
% Cylindrical to Spherical
R=sqrt(r^2+z^2);
theta=acosd(z/R);
disp('cylindrical to spherical coordinate system of s(r,phi,theta)=');
disp([R phi theta]);
