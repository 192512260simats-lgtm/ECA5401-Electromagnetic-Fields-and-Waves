clc;
clear;
close all;

% Constants
mu0 = 4*pi*1e-7;      % Permeability of free space (H/m)
I1 = 5;               % Current in conductor 1 (A)
I2 = 10;              % Current in conductor 2 (A)

% Distance between conductors
d = linspace(0.1, 10, 100);   % Distance (m)

% Force per unit length
F = (mu0 * I1 * I2) ./ (2 * pi * d);

% Plot
plot(d, F, 'b', 'LineWidth', 2);
grid on;

xlabel('Distance (m)');
ylabel('Force per Unit Length (N/m)');
title('Force Between Two Parallel Conductors');
